# Razorpay API credentials (test mode)
RAZORPAY_KEY_ID=your_test_key_id_here
RAZORPAY_KEY_SECRET=your_test_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Payment provider selection
# Set to 'false' to use the real Razorpay test-mode API instead of the mock provider.
# Requires valid RAZORPAY_KEY_ID and RAZORPAY_KEY_SECRET.
USE_MOCK_PROVIDER=true

# Database URL (SQLite by default, swap to Postgres later)
DATABASE_URL=sqlite:///./churnguard.db

# Environment
ENVIRONMENT=development
